{
  "name": "sotto",
  "version": "1.0.0",
  "private": true,
  "description": "A private, on-device transcription workspace. No API keys. No subscriptions.",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend -- --host 0.0.0.0",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend -- --host 0.0.0.0",
    "test": "npm run test --workspace frontend",
    "test:e2e": "npm run test:e2e --workspace frontend --"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "license": "MIT"
}
